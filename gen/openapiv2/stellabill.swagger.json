            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/v1ListPlansResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/rpcStatus"
            }
          }
        },
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "type": "integer",
            "format": "int32"
          },
          {
            "name": "cursor",
            "in": "query",
            "required": false,
            "type": "string"
          }
        ],
        "tags": [
          "PlanService"
        ]
      }
    },
    "/api/v1/plans/{id}": {
      "get": {
        "summary": "GetPlan returns a single plan by ID.",
